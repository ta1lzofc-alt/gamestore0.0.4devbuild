
<Window x:Class="GameStore.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStore"
        Height="800"
        Width="1250"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}">

    <Window.Resources>

        <SolidColorBrush x:Key="Yellow" Color="#FFD400"/>
        <SolidColorBrush x:Key="SteamBlue" Color="#66C0F4"/>

        <!-- ОСНОВНОЙ СТИЛЬ КНОПОК -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                TextElement.FontWeight="SemiBold"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#344B63"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#66C0F4"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#405C78"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ПОЛЯ ВВОДА -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CaretBrush" Value="#66C0F4"/>
        </Style>

        <!-- ВЫПАДАЮЩИЕ СПИСКИ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource AppInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВОЕ МЕНЮ -->
        <Border Grid.Column="0"
                Background="{DynamicResource AppPanel}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="18">

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="GAMESTORE"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#66C0F4"
                               Margin="0,15,0,45"/>

                    <TextBlock Text="МЕНЮ"
                               Foreground="{DynamicResource AppSecondary}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="12,0,0,12"/>

                    <Button Content="⌂   Главная"
                            Click="Home_Click"/>

                    <Button Content="▦   Магазин"
                            Click="Store_Click"/>

                    <Button Content="▣   Библиотека"
                            Click="Library_Click"/>

                    <Button x:Name="CartButton"
                            Content="🛒   Корзина (0)"
                            Click="Cart_Click"/>

                    <TextBlock Text="АККАУНТ"
                               Foreground="{DynamicResource AppSecondary}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="12,30,0,12"/>

                    <Button Content="♙   Профиль"
                            Click="Profile_Click"/>

                    <Button Content="⚙   Настройки"
                            Click="Settings_Click"/>

                    <Button Content="⇥   Выйти"
                            Click="Logout_Click"
                            Foreground="#FF7777"
                            Margin="0,25,0,0"
                            FontWeight="Bold"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource AppCard}"
                            CornerRadius="10"
                            Padding="12"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">

                        <StackPanel>
                            <TextBlock Text="GAMESTORE"
                                       Foreground="#66C0F4"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Твоя игровая платформа"
                                       Foreground="{DynamicResource AppSecondary}"
                                       FontSize="11"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AppPanel}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">
                    <TextBlock Text="GameStore"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource AppSecondary}"
                               FontSize="14"/>
                </Grid>
            </Border>

            <!-- СТРАНИЦЫ -->
            <Grid Grid.Row="1">

                <!-- МАГАЗИН -->
                <ScrollViewer x:Name="StorePage"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="30,20,30,30">

                        <Border Height="210"
                                CornerRadius="15"
                                Padding="30"
                                Margin="0,0,0,30">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#24415D" Offset="0"/>
                                    <GradientStop Color="#172331" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="ТВОЙ ИГРОВОЙ МИР"
                                           Foreground="#66C0F4"
                                           FontWeight="Bold"
                                           FontSize="12"/>

                                <TextBlock Text="Играй. Исследуй. Побеждай."
                                           FontSize="29"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,12,0,8"/>

                                <TextBlock Text="Открывай новые игры и собирай свою коллекцию."
                                           Foreground="#C4D4E0"
                                           FontSize="14"/>

                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="PageTitle"
                                   Text="Каталог игр"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox"
                                     Height="40"
                                     Background="{DynamicResource AppInput}"
                                     Foreground="{DynamicResource AppForeground}"
                                     BorderBrush="{DynamicResource AppBorder}"
                                     BorderThickness="1"
                                     Padding="12"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>

                            <Button Grid.Column="1"
                                    Content="НАЙТИ"
                                    Background="#FFD400"
                                    Foreground="#171A21"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    HorizontalContentAlignment="Center"
                                    Margin="10,0,0,0"
                                    Padding="20,10"
                                    Click="SearchButton_Click"/>
                        </Grid>

                        <TextBlock x:Name="StatusText"
                                   Text="Загрузка каталога..."
                                   Foreground="{DynamicResource AppSecondary}"
                                   Margin="0,0,0,15"/>

                        <ItemsControl ItemsSource="{Binding Games}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Width="230"
                                            Background="{DynamicResource AppCard}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,0,15,15"
                                            Padding="15">

                                        <StackPanel>

                                            <Border Height="120"
                                                    Background="#172331"
                                                    CornerRadius="8"
                                                    ClipToBounds="True">

                                                <Image Source="{Binding CoverUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AppForeground}"
                                                       Margin="0,12,0,5"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Genres}"
                                                       Foreground="{DynamicResource AppSecondary}"
                                                       FontSize="12"/>

                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource AppSecondary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="55"
                                                       Margin="0,8,0,8"/>

                                            <TextBlock Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                                       Foreground="#FFD400"
                                                       FontWeight="Bold"
                                                       FontSize="17"/>

                                            <Button Content="В КОРЗИНУ"
                                                    Background="#FFD400"
                                                    Foreground="#171A21"
                                                    BorderThickness="0"
                                                    FontWeight="Bold"
                                                    HorizontalContentAlignment="Center"
                                                    Margin="0,10,0,0"
                                                    Click="AddToCart_Click"
                                                    Tag="{Binding}"/>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- БИБЛИОТЕКА -->
                <Grid x:Name="LibraryPage"
                      Visibility="Collapsed">

                    <StackPanel Margin="30">

                        <TextBlock Text="МОЯ БИБЛИОТЕКА"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#66C0F4"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="LibraryCountText"
                                   Text="Игр в библиотеке: 0"
                                   Foreground="{DynamicResource AppSecondary}"
                                   FontSize="14"
                                   Margin="0,0,0,20"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <ItemsControl ItemsSource="{Binding LibraryGames}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Width="230"
                                                Margin="0,0,15,15"
                                                Padding="12"
                                                Background="{DynamicResource AppCard}"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <StackPanel>

                                                <Border Height="120"
                                                        CornerRadius="8"
                                                        ClipToBounds="True">

                                                    <Image Source="{Binding CoverUrl}"
                                                           Stretch="UniformToFill"/>
                                                </Border>

                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{DynamicResource AppForeground}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Margin="0,10,0,5"/>

                                                <TextBlock Text="{Binding Genres}"
                                                           Foreground="{DynamicResource AppSecondary}"
                                                           FontSize="12"/>

                                                <TextBlock Text="В вашей библиотеке"
                                                           Foreground="#66C0F4"
                                                           FontSize="12"
                                                           Margin="0,10,0,0"/>

                                            </StackPanel>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- КОРЗИНА -->
                <ScrollViewer x:Name="CartPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="35">

                        <TextBlock Text="КОРЗИНА"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppForeground}"
                                   Margin="0,0,0,25"/>

                        <ItemsControl ItemsSource="{Binding CartGames}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="{DynamicResource AppCard}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="15"
                                            Margin="0,0,0,12">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource AppForeground}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Price, StringFormat={}{0:N2} ₽}"
                                                       Foreground="#FFD400"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="15,0"/>

                                            <Button Grid.Column="2"
                                                    Content="УДАЛИТЬ"
                                                    Foreground="#FF7777"
                                                    Click="RemoveFromCart_Click"
                                                    Tag="{Binding}"/>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="CartTotalText"
                                   Text="Итого: 0 ₽"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FFD400"
                                   Margin="0,20"/>

                        <Button Content="ОФОРМИТЬ ЗАКАЗ"
                                Background="#FFD400"
                                Foreground="#171A21"
                                BorderThickness="0"
                                FontWeight="Bold"
                                HorizontalContentAlignment="Center"
                                Width="220"
                                Click="Checkout_Click"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- ПРОФИЛЬ -->
                <ScrollViewer x:Name="ProfilePage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="35">

                        <TextBlock Text="МОЙ ПРОФИЛЬ"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#66C0F4"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Информация о вашем аккаунте GameStore"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppSecondary}"
                                   Margin="0,0,0,25"/>

                        <Border Background="{DynamicResource AppCard}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="25"
                                MaxWidth="650"
                                HorizontalAlignment="Left">

                            <StackPanel>

                                <Border Width="75"
                                        Height="75"
                                        CornerRadius="40"
                                        Background="#24415D"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,20">

                                    <TextBlock Text="♙"
                                               FontSize="38"
                                               Foreground="#66C0F4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="ЛОГИН"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppSecondary}"/>

                                <TextBlock x:Name="ProfileUsername"
                                           Text="Загрузка..."
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppForeground}"
                                           Margin="0,6,0,22"/>

                                <Border Height="1"
                                        Background="{DynamicResource AppBorder}"
                                        Margin="0,0,0,18"/>

                                <TextBlock Text="EMAIL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppSecondary}"/>

                                <TextBlock x:Name="ProfileEmail"
                                           Text="Загрузка..."
                                           FontSize="16"
                                           Foreground="{DynamicResource AppForeground}"
                                           Margin="0,6,0,22"
                                           TextWrapping="Wrap"/>

                                <Border Height="1"
                                        Background="{DynamicResource AppBorder}"
                                        Margin="0,0,0,18"/>

                                <TextBlock Text="ДАТА РЕГИСТРАЦИИ"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppSecondary}"/>

                                <TextBlock x:Name="ProfileCreatedAt"
                                           Text="Загрузка..."
                                           FontSize="16"
                                           Foreground="#66C0F4"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </Border>

                        <TextBlock Text="Ваш аккаунт GameStore"
                                   Foreground="{DynamicResource AppSecondary}"
                                   FontSize="12"
                                   Margin="0,20,0,0"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- НАСТРОЙКИ -->
                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="35">

                        <TextBlock Text="НАСТРОЙКИ"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#66C0F4"/>

                        <TextBlock Text="Персонализация приложения"
                                   Foreground="{DynamicResource AppSecondary}"
                                   Margin="0,10,0,25"/>

                        <Border Background="{DynamicResource AppCard}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22"
                                MaxWidth="600"
                                HorizontalAlignment="Left">

                            <StackPanel>

                                <TextBlock Text="ОФОРМЛЕНИЕ"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppForeground}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Выбери тему приложения"
                                           Foreground="{DynamicResource AppSecondary}"
                                           Margin="0,0,0,15"/>

                                <ComboBox x:Name="ThemeSelector"
                                        SelectionChanged="ThemeSelector_SelectionChanged"
                                        Width="180">
                                    <ComboBoxItem Content="Тёмная"/>
                                    <ComboBoxItem Content="Светлая"/>
                                </ComboBox>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Window>
