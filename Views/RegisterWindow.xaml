
<Window x:Class="GameStore.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStore — Регистрация"
        Height="680"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171923">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,5,0,25">
            <TextBlock Text="СОЗДАТЬ АККАУНТ"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="#8B7CFF"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Добро пожаловать в GameStore"
                       FontSize="14"
                       Foreground="#A0A4B8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Логин -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Логин"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="UsernameInput"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     Background="#252938"
                     Foreground="White"
                     BorderBrush="#41465C"/>
        </StackPanel>

        <!-- Email -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Email"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="EmailInput"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     Background="#252938"
                     Foreground="White"
                     BorderBrush="#41465C"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Пароль"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="PasswordInput"
                         Height="40"
                         FontSize="14"
                         Padding="10"
                         Background="#252938"
                         Foreground="White"
                         BorderBrush="#41465C"/>
        </StackPanel>

        <!-- Повтор пароля -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Повторите пароль"
                       Foreground="White"
                       Margin="0,0,0,6"/>

            <PasswordBox x:Name="ConfirmPasswordInput"
                         Height="40"
                         FontSize="14"
                         Padding="10"
                         Background="#252938"
                         Foreground="White"
                         BorderBrush="#41465C"/>
        </StackPanel>

        <!-- Кнопка и ошибка -->
        <StackPanel Grid.Row="5">
            <Button x:Name="RegisterButton"
                    Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                    Height="45"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#7463E8"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Register_Click"/>

            <Border x:Name="ErrorBorder"
                    Background="#30202A"
                    CornerRadius="6"
                    Margin="0,12,0,0"
                    Padding="10"
                    MaxHeight="90"
                    Visibility="Collapsed">

                <TextBlock x:Name="ErrorText"
                           Foreground="#FF7777"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Нижняя подпись -->
        <TextBlock Grid.Row="6"
                   Text="GameStore © 2026"
                   Foreground="#656A7D"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,15,0,5"/>
    </Grid>
</Window>
