
<Window x:Class="GameStore.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStore — Вход"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#171923">

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,30">
            <TextBlock Text="GAMESTORE"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#8B7CFF"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Войдите в свой аккаунт"
                       FontSize="15"
                       Foreground="#A0A4B8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Логин или email"
                       Foreground="White"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="LoginInput"
                     Height="42"
                     FontSize="15"
                     Padding="10"
                     Background="#252938"
                     Foreground="White"
                     BorderBrush="#41465C"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Пароль"
                       Foreground="White"
                       Margin="0,0,0,7"/>

            <PasswordBox x:Name="PasswordInput"
                         Height="42"
                         FontSize="15"
                         Padding="10"
                         Background="#252938"
                         Foreground="White"
                         BorderBrush="#41465C"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Button Content="ВОЙТИ"
                    Height="45"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#7463E8"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Login_Click"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF7777"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center">

            <TextBlock Text="Ещё нет аккаунта?"
                       Foreground="#A0A4B8"
                       HorizontalAlignment="Center"/>

            <Button Content="Создать аккаунт"
                    Background="Transparent"
                    Foreground="#A99AFF"
                    BorderThickness="0"
                    FontSize="14"
                    Click="Register_Click"
                    Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
